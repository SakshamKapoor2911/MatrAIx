{
  "schemaVersion": "1.0",
  "contextRules": [
    {
      "match": {
        "contextType": "file_transform"
      },
      "summaryDirectives": [
        {
          "id": "file_transform.reason_by_output_format",
          "title": "Reason by output format",
          "targetFacetKey": "reason",
          "groupByFacetKey": "output_format",
          "groupByMode": "categorical",
          "summaryKind": "llm_bucket_summary"
        }
      ]
    },
    {
      "match": {
        "contextType": "user_feedback"
      },
      "summaryDirectives": [
        {
          "id": "user_feedback.reason_by_need_satisfaction",
          "title": "Feedback reason by need satisfaction",
          "targetFacetKey": "feedback_reason",
          "groupByFacetKey": "need_constraint_satisfaction",
          "groupByMode": "categorical",
          "summaryKind": "llm_bucket_summary"
        }
      ],
      "judgeDirectives": [
        {
          "id": "user_feedback.reason_signal_scan",
          "title": "Feedback signal scan",
          "targetFacetKey": "feedback_reason",
          "groupByFacetKey": "personal_preference_satisfaction",
          "groupByMode": "categorical",
          "judgeKind": "llm_signal_judge",
          "prompt": "Read the persona's feedback and mark which reusable subjective OS/app-task signals are explicitly present.",
          "rubric": "Mark a signal true only when the feedback clearly states or strongly implies that signal.",
          "signals": [
            { "key": "fit_signal", "label": "Need or preference fit", "valueType": "boolean" },
            { "key": "trust_signal", "label": "Trust or confidence", "valueType": "boolean" },
            { "key": "effort_signal", "label": "Low or high effort", "valueType": "boolean" },
            { "key": "clarity_signal", "label": "Clear next step", "valueType": "boolean" }
          ]
        }
      ]
    }
  ]
}
