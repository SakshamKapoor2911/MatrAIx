{
  "schemaVersion": "1.0",
  "contextRules": [
    {
      "match": {
        "contextType": "task_outcome"
      },
      "distributions": [
        {
          "id": "task_outcome.status_by_segment",
          "facetKey": "outcome_status",
          "title": "Outcome status"
        },
        {
          "id": "task_outcome.completion_by_segment",
          "facetKey": "goal_completion_bucket",
          "title": "Goal completion"
        },
        {
          "id": "task_outcome.optimality_by_segment",
          "facetKey": "ev_optimality_score",
          "title": "EV optimality score"
        },
        {
          "id": "task_outcome.consistency_by_segment",
          "facetKey": "persona_consistency_score",
          "title": "Persona consistency score"
        }
      ],
      "summaryDirectives": [
        {
          "id": "task_outcome.explanation_by_status",
          "title": "Outcome explanation by status",
          "targetFacetKey": "outcome_explanation",
          "groupByFacetKey": "outcome_status",
          "groupByMode": "categorical",
          "summaryKind": "llm_bucket_summary"
        }
      ]
    },
    {
      "match": {
        "contextType": "decision"
      },
      "distributions": [
        {
          "id": "decision.strategy_by_segment",
          "facetKey": "task_strategy_basis",
          "title": "Strategy basis"
        },
        {
          "id": "decision.risk_by_segment",
          "facetKey": "risk_posture",
          "title": "Risk posture"
        },
        {
          "id": "decision.basis_by_segment",
          "facetKey": "basis_primary",
          "title": "Primary basis"
        }
      ],
      "summaryDirectives": [
        {
          "id": "decision.reason_by_strategy",
          "title": "Reason by poker strategy",
          "targetFacetKey": "reason",
          "groupByFacetKey": "task_strategy_basis",
          "groupByMode": "categorical",
          "summaryKind": "llm_bucket_summary"
        },
        {
          "id": "decision.reason_by_risk_posture",
          "title": "Reason by risk posture",
          "targetFacetKey": "reason",
          "groupByFacetKey": "risk_posture",
          "groupByMode": "categorical",
          "summaryKind": "llm_bucket_summary"
        }
      ],
      "judgeDirectives": [
        {
          "id": "decision.holdem_signal_scan",
          "title": "Texas Hold'em decision signal scan",
          "targetFacetKey": "reason",
          "groupByFacetKey": "risk_posture",
          "groupByMode": "categorical",
          "judgeKind": "llm_signal_judge",
          "prompt": "Read the persona's Texas Hold'em decision reason and classify which strategic signals are explicitly present.",
          "rubric": "Mark a signal true only when the reason clearly states or strongly implies that signal.",
          "signals": [
            {
              "key": "hand_strength_signal",
              "label": "Hand strength reasoning",
              "valueType": "boolean"
            },
            {
              "key": "pot_odds_signal",
              "label": "Pot odds or value calculation",
              "valueType": "boolean"
            },
            {
              "key": "bluff_signal",
              "label": "Bluffing or bluff-catching",
              "valueType": "boolean"
            },
            {
              "key": "risk_control_signal",
              "label": "Risk control or chip preservation",
              "valueType": "boolean"
            }
          ]
        },
        {
          "id": "decision.persona_alignment_judge",
          "title": "Persona-behavior alignment judge",
          "targetFacetKey": "reason",
          "groupByFacetKey": "risk_posture",
          "groupByMode": "categorical",
          "judgeKind": "llm_signal_judge",
          "prompt": "Evaluate whether the persona played consistent with their specified risk posture and decision style.",
          "rubric": "Mark true if the gameplay actions and reasoning reflect their stated persona dimensions.",
          "signals": [
            {
              "key": "persona_consistency_signal",
              "label": "Persona behavioral consistency",
              "valueType": "boolean"
            }
          ]
        }
      ]
    },
    {
      "match": {
        "contextType": "decision_process"
      },
      "distributions": [
        {
          "id": "decision_process.exploration_by_segment",
          "facetKey": "exploration_style",
          "title": "Exploration style"
        }
      ]
    },
    {
      "match": {
        "contextType": "user_feedback"
      },
      "distributions": [
        {
          "id": "user_feedback.rating_by_segment",
          "facetKey": "overall_experience_rating",
          "title": "Overall experience rating"
        },
        {
          "id": "user_feedback.need_by_segment",
          "facetKey": "need_constraint_satisfaction",
          "title": "Need or constraint satisfaction"
        },
        {
          "id": "user_feedback.preference_by_segment",
          "facetKey": "personal_preference_satisfaction",
          "title": "Personal preference satisfaction"
        },
        {
          "id": "user_feedback.effort_by_segment",
          "facetKey": "effort_rating",
          "title": "Effort rating"
        }
      ],
      "summaryDirectives": [
        {
          "id": "user_feedback.reason_by_need_satisfaction",
          "title": "Feedback reason by goal satisfaction",
          "targetFacetKey": "feedback_reason",
          "groupByFacetKey": "need_constraint_satisfaction",
          "groupByMode": "categorical",
          "summaryKind": "llm_bucket_summary"
        }
      ]
    }
  ]
}
