      "confidence": 0.82
    },
    {
      "questionId": "q2",
      "value": "q2_annual_after_long_use",
      "rationale": "I prefer monthly flexibility initially because I want to cancel guilt-free if the app doesn't stick. But once I've used it reliably for 3–4 months and it becomes essential, I'd lock in annual billing for the discount.",
      "confidence": 0.8
    },
    {
